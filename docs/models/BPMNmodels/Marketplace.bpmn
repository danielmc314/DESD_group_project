    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Event_0a3wlo9" name="recive payment retry decision">
      <bpmn:incoming>Flow_0dgn3f7</bpmn:incoming>
      <bpmn:outgoing>Flow_0y303ku</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1ckuytq" messageRef="Message_34p83ej" />
    </bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="Activity_0g2c1v0" name="validate order">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output target="OutputVariable_1n6af6j" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_198l9sg</bpmn:incoming>
      <bpmn:outgoing>Flow_0nhw66y</bpmn:outgoing>
      <bpmn:startEvent id="Event_1196rth" name="start validity check">
        <bpmn:outgoing>Flow_0bxfe95</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="Event_06rm97f" name="finish subprocess">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="={unavailibleItems: unavailibleItems}" target="unavailableItems" />
            <zeebe:output source="={orderValidity: orderValidity}" target="orderValidity" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1kg08ea</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:scriptTask id="Activity_0gdbqgt" name="check product stock and availability">
        <bpmn:extensionElements>
          <zeebe:script expression="=&#10;&#10;for orderItem in customerOrder.orderItems return&#10;{&#10;  productId: orderItem.productId,&#10;  requestedQuantity: orderItem.requestedQuantity,&#10;  stockAvailable:&#10;    some vendor in inventory satisfies&#10;      (some product in vendor.products satisfies&#10;        product.productId = orderItem.productId&#10;        and product.active = true&#10;        and product.availableStock &#62;= orderItem.requestedQuantity&#10;        and orderItem.requestedQuantity &#62; 0)&#10;}&#10;" resultVariable="itemAvailability" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0bxfe95</bpmn:incoming>
        <bpmn:outgoing>Flow_0iflr8j</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Activity_1udgpxw" name="generate list of unavailable items">
        <bpmn:extensionElements>
          <zeebe:script expression="=&#10;flatten(&#10;  for item in itemAvailability return&#10;    for d in dateAvailability return&#10;      if item.productId = d.productId&#10;         and (&#10;           item.stockAvailable = false&#10;           or d.dateValid = false&#10;         )&#10;      then [&#10;        {&#10;          productId: item.productId,&#10;          requestedQuantity: item.requestedQuantity,&#10;          stockAvailable: item.stockAvailable,&#10;          dateAvailable: d.dateValid&#10;        }&#10;      ]&#10;      else []&#10;)&#10;&#10;" resultVariable="unavailibleItems" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_03bl7rt</bpmn:incoming>
        <bpmn:outgoing>Flow_01bva2c</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Activity_01v6nn4" name="record order validation results">
        <bpmn:extensionElements>
          <zeebe:script expression="=count(unavailableItems) = 0&#10;&#10;" resultVariable="orderValidity" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_01bva2c</bpmn:incoming>
        <bpmn:outgoing>Flow_1kg08ea</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Activity_1e5o4a7" name="check expiry dates">
        <bpmn:extensionElements>
          <zeebe:script expression="=&#10;for orderItem in customerOrder.orderItems return&#10;{&#10;  productId: orderItem.productId,&#10;  dateValid:&#10;    some vendor in inventory satisfies&#10;      (some product in vendor.products satisfies&#10;        product.productId = orderItem.productId&#10;        and product.active = true&#10;        and date(product.bestBeforeDate)&#10;            &#62;= date(customerOrder.requestedFulfilmentDate))&#10;}&#10;" resultVariable="dateAvalibility" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0iflr8j</bpmn:incoming>
        <bpmn:outgoing>Flow_03bl7rt</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="Flow_0bxfe95" sourceRef="Event_1196rth" targetRef="Activity_0gdbqgt" />
      <bpmn:sequenceFlow id="Flow_1kg08ea" sourceRef="Activity_01v6nn4" targetRef="Event_06rm97f" />
      <bpmn:sequenceFlow id="Flow_0iflr8j" sourceRef="Activity_0gdbqgt" targetRef="Activity_1e5o4a7" />
      <bpmn:sequenceFlow id="Flow_03bl7rt" sourceRef="Activity_1e5o4a7" targetRef="Activity_1udgpxw" />
      <bpmn:sequenceFlow id="Flow_01bva2c" sourceRef="Activity_1udgpxw" targetRef="Activity_01v6nn4" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_0c8068d" sourceRef="Event_18onoji" targetRef="Gateway_1rzrcnb" />
    <bpmn:sequenceFlow id="Flow_0nerpal" name="yes" sourceRef="Gateway_01ks6ae" targetRef="Activity_1aidbss">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderValidity = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0b8newe" sourceRef="Activity_1aidbss" targetRef="Gateway_1bzgua6" />
    <bpmn:sequenceFlow id="Flow_0guu4ka" sourceRef="Gateway_1bzgua6" targetRef="Event_1wlvcvz" />
    <bpmn:sequenceFlow id="Flow_1fbkfyz" sourceRef="Gateway_1bzgua6" targetRef="Event_1f6ydga" />
    <bpmn:sequenceFlow id="Flow_0tt5q6d" sourceRef="Event_1wlvcvz" targetRef="Event_13y2oqu" />
    <bpmn:sequenceFlow id="Flow_00jlzlg" sourceRef="Event_1f6ydga" targetRef="Activity_153thcw" />
    <bpmn:sequenceFlow id="Flow_0uu8vjb" sourceRef="Activity_1ycq2ig" targetRef="Gateway_0f1f85f" />
    <bpmn:sequenceFlow id="Flow_0po2wne" sourceRef="Gateway_1s4l6p3" targetRef="Gateway_0f1f85f" />
    <bpmn:sequenceFlow id="Flow_0c8p4ki" sourceRef="Gateway_0f1f85f" targetRef="Activity_02mda3y" />
    <bpmn:sequenceFlow id="Flow_0eyxnb2" sourceRef="Activity_02mda3y" targetRef="Event_1inzxli" />
