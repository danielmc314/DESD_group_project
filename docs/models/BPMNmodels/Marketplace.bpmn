    <bpmn:subProcess id="Activity_153thcw" name="create multi-vendor order">
      <bpmn:incoming>Flow_00jlzlg</bpmn:incoming>
      <bpmn:outgoing>Flow_0ci9hao</bpmn:outgoing>
      <bpmn:startEvent id="Event_1bz464e" name="start multi-vendor order creation">
        <bpmn:outgoing>Flow_17fw6pv</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:scriptTask id="Activity_02thd9q" name="retrieve ordered product details">
        <bpmn:extensionElements>
          <zeebe:script expression="=&#10;flatten(&#10;  for orderItem in customerOrder.orderItems return&#10;    for vendor in inventory return&#10;      for product in vendor.products return&#10;        if product.productId = orderItem.productId&#10;        then [&#10;          {&#10;            productId: product.productId,&#10;            productName: product.productName,&#10;            vendorId: vendor.vendorId,&#10;            vendorName: vendor.vendorName,&#10;            quantity: orderItem.requestedQuantity,&#10;            unitPrice: product.price,&#10;            lineTotal: product.price * orderItem.requestedQuantity&#10;          }&#10;        ]&#10;        else []&#10;)&#10;" resultVariable="order lines" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_17fw6pv</bpmn:incoming>
        <bpmn:outgoing>Flow_12kh6zi</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Activity_0x4nxif" name="group order items by vendorId">
        <bpmn:extensionElements>
          <zeebe:script expression="=&#10;for id in distinct values(orderLines.vendorId) return&#10;{&#10;  vendorId: id,&#10;  vendorName:&#10;    flatten(&#10;      for line in orderLines return&#10;        if line.vendorId = id&#10;        then [line.vendorName]&#10;        else []&#10;    )[1],&#10;  items:&#10;    flatten(&#10;      for line in orderLines return&#10;        if line.vendorId = id&#10;        then [line]&#10;        else []&#10;    )&#10;}&#10;&#10;" resultVariable="groupedByVendor" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_12kh6zi</bpmn:incoming>
        <bpmn:outgoing>Flow_0jp2llk</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Activity_0lu4udm" name="calculate totals for each vendor">
        <bpmn:extensionElements>
          <zeebe:script expression="=&#10;{&#10;  vendorTotals:&#10;    for vendor in vendorOrders return&#10;    {&#10;      vendorId: vendor.vendorId,&#10;      vendorName: vendor.vendorName,&#10;      subtotal: sum(vendor.items.lineTotal)&#10;    },&#10;&#10;  orderTotal:&#10;    sum(&#10;      for vendor in vendorOrders return&#10;        sum(vendor.items.lineTotal)&#10;    )&#10;}&#10;" resultVariable="vendorTotals" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0jp2llk</bpmn:incoming>
        <bpmn:outgoing>Flow_18537qc</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Activity_088s4sd" name="build final multi-vendor order">
        <bpmn:extensionElements>
          <zeebe:script expression="=&#10;{&#10;  customerId: customerOrder.customerId,&#10;  orderDate: customerOrder.orderDate,&#10;  requestedFulfilmentDate: customerOrder.requestedFulfilmentDate,&#10;  fulfilmentMethod: customerOrder.fulfilmentMethod,&#10;&#10;  vendorOrders: vendorOrders,&#10;&#10;  vendorTotals: orderTotals.vendorTotals,&#10;&#10;  orderTotal: orderTotals.orderTotal,&#10;&#10;  orderStatus: &#34;Pending Payment&#34;&#10;}&#10;" resultVariable="multiVendorOrder" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_18537qc</bpmn:incoming>
        <bpmn:outgoing>Flow_019au3y</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="Flow_17fw6pv" sourceRef="Event_1bz464e" targetRef="Activity_02thd9q" />
      <bpmn:sequenceFlow id="Flow_12kh6zi" sourceRef="Activity_02thd9q" targetRef="Activity_0x4nxif" />
      <bpmn:sequenceFlow id="Flow_0jp2llk" sourceRef="Activity_0x4nxif" targetRef="Activity_0lu4udm" />
      <bpmn:sequenceFlow id="Flow_18537qc" sourceRef="Activity_0lu4udm" targetRef="Activity_088s4sd" />
      <bpmn:endEvent id="Event_1rm1aev" name="subprocess finished">
        <bpmn:incoming>Flow_019au3y</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_019au3y" sourceRef="Activity_088s4sd" targetRef="Event_1rm1aev" />
    </bpmn:subProcess>
