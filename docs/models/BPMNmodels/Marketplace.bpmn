    <bpmn:exclusiveGateway id="Gateway_1s4l6p3" name="retry?">
      <bpmn:incoming>Flow_0y303ku</bpmn:incoming>
      <bpmn:outgoing>Flow_0cnvxnv</bpmn:outgoing>
      <bpmn:outgoing>Flow_0po2wne</bpmn:outgoing>
