      <bpmn:incoming>Flow_0c8p4ki</bpmn:incoming>
      <bpmn:outgoing>Flow_0eyxnb2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_0f1f85f">
      <bpmn:incoming>Flow_0uu8vjb</bpmn:incoming>
      <bpmn:incoming>Flow_0po2wne</bpmn:incoming>
      <bpmn:outgoing>Flow_0c8p4ki</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_1ycq2ig" name="calculate commision">
      <bpmn:incoming>Flow_0ci9hao</bpmn:incoming>
      <bpmn:outgoing>Flow_0uu8vjb</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="Activity_153thcw" name="create multi-vendor order">
      <bpmn:incoming>Flow_00jlzlg</bpmn:incoming>
      <bpmn:outgoing>Flow_0ci9hao</bpmn:outgoing>
      <bpmn:startEvent id="Event_1bz464e" name="start multi-vendor order creation">
        <bpmn:outgoing>Flow_17fw6pv</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:scriptTask id="Activity_02thd9q" name="retrieve ordered product details">
        <bpmn:extensionElements>
          <zeebe:script expression="=&#10;flatten(&#10;  for orderItem in customerOrder.orderItems return&#10;    for vendor in inventory return&#10;      for product in vendor.products return&#10;        if product.productId = orderItem.productId&#10;        then [&#10;          {&#10;            productId: product.productId,&#10;            productName: product.productName,&#10;            vendorId: vendor.vendorId,&#10;            vendorName: vendor.vendorName,&#10;            quantity: orderItem.requestedQuantity,&#10;            unitPrice: product.price,&#10;            lineTotal: product.price * orderItem.requestedQuantity&#10;          }&#10;        ]&#10;        else []&#10;)&#10;" resultVariable="orderLines" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_17fw6pv</bpmn:incoming>
        <bpmn:outgoing>Flow_12kh6zi</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Activity_0x4nxif" name="group order items by vendorId">
        <bpmn:extensionElements>
          <zeebe:script expression="=&#10;for id in distinct values(orderLines.vendorId) return&#10;{&#10;  vendorId: id,&#10;  vendorName:&#10;    flatten(&#10;      for line in orderLines return&#10;        if line.vendorId = id&#10;        then [line.vendorName]&#10;        else []&#10;    )[1],&#10;  items:&#10;    flatten(&#10;      for line in orderLines return&#10;        if line.vendorId = id&#10;        then [line]&#10;        else []&#10;    )&#10;}&#10;&#10;" resultVariable="groupedByVendor" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_12kh6zi</bpmn:incoming>
        <bpmn:outgoing>Flow_0jp2llk</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Activity_0lu4udm" name="calculate totals for each vendor">
        <bpmn:extensionElements>
          <zeebe:script expression="=&#10;{&#10;  vendorTotals:&#10;    for vendor in vendorOrders return&#10;    {&#10;      vendorId: vendor.vendorId,&#10;      vendorName: vendor.vendorName,&#10;      subtotal: sum(vendor.items.lineTotal)&#10;    },&#10;&#10;  orderTotal:&#10;    sum(&#10;      for vendor in vendorOrders return&#10;        sum(vendor.items.lineTotal)&#10;    )&#10;}&#10;" resultVariable="vendorTotals" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0jp2llk</bpmn:incoming>
        <bpmn:outgoing>Flow_18537qc</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Activity_088s4sd" name="build final multi-vendor order">
        <bpmn:extensionElements>
          <zeebe:script expression="=&#10;{&#10;  customerId: customerOrder.customerId,&#10;  orderDate: customerOrder.orderDate,&#10;  requestedFulfilmentDate: customerOrder.requestedFulfilmentDate,&#10;  fulfilmentMethod: customerOrder.fulfilmentMethod,&#10;&#10;  vendorOrders: vendorOrders,&#10;&#10;  vendorTotals: orderTotals.vendorTotals,&#10;&#10;  orderTotal: orderTotals.orderTotal,&#10;&#10;  orderStatus: &#34;Pending Payment&#34;&#10;}&#10;" resultVariable="multiVendorOrder" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_18537qc</bpmn:incoming>
        <bpmn:outgoing>Flow_019au3y</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="Flow_17fw6pv" sourceRef="Event_1bz464e" targetRef="Activity_02thd9q" />
      <bpmn:sequenceFlow id="Flow_12kh6zi" sourceRef="Activity_02thd9q" targetRef="Activity_0x4nxif" />
      <bpmn:sequenceFlow id="Flow_0jp2llk" sourceRef="Activity_0x4nxif" targetRef="Activity_0lu4udm" />
      <bpmn:sequenceFlow id="Flow_18537qc" sourceRef="Activity_0lu4udm" targetRef="Activity_088s4sd" />
      <bpmn:endEvent id="Event_1rm1aev" name="subprocess finished">
        <bpmn:incoming>Flow_019au3y</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_019au3y" sourceRef="Activity_088s4sd" targetRef="Event_1rm1aev" />
    </bpmn:subProcess>
    <bpmn:intermediateCatchEvent id="Event_1f6ydga" name="receive confirmation">
      <bpmn:incoming>Flow_1fbkfyz</bpmn:incoming>
      <bpmn:outgoing>Flow_00jlzlg</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0fnsfyy" messageRef="Message_0dbpsj2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:startEvent id="Event_18onoji" name="receive customer order">
      <bpmn:outgoing>Flow_0904mej</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0flcs5b" messageRef="Message_3csupf2" />
    </bpmn:startEvent>
    <bpmn:subProcess id="Activity_0g2c1v0" name="validate order">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=orderValidity" target="orderValidity" />
          <zeebe:output source="=unavailableItems" target="unavailableItems" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_198l9sg</bpmn:incoming>
      <bpmn:outgoing>Flow_0nhw66y</bpmn:outgoing>
      <bpmn:startEvent id="Event_1196rth" name="start validity check">
        <bpmn:outgoing>Flow_0bxfe95</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="Event_06rm97f" name="finish subprocess">
        <bpmn:extensionElements />
        <bpmn:incoming>Flow_1kg08ea</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:scriptTask id="Activity_0gdbqgt" name="check product stock and availability">
        <bpmn:extensionElements>
          <zeebe:script expression="=&#10;&#10;for item in customerOrder.orderItems return&#10;{&#10;  productId: item.productId,&#10;  requestedQuantity: item.requestedQuantity,&#10;  stockAvailable:&#10;    some vendor in inventory satisfies&#10;      (some product in vendor.products satisfies&#10;        product.productId = item.productId&#10;        and product.availableStock &#62;= item.requestedQuantity&#10;        and item.requestedQuantity &#62; 0)&#10;}&#10;" resultVariable="itemAvailability" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0bxfe95</bpmn:incoming>
        <bpmn:outgoing>Flow_0iflr8j</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Activity_1udgpxw" name="generate list of unavailable items">
        <bpmn:extensionElements>
          <zeebe:script expression="=&#10;{&#10;  checkedItems:&#10;    for item in itemAvailability return&#10;      {&#10;        productId: item.productId,&#10;        requestedQuantity: item.requestedQuantity,&#10;        stockAvailable: item.stockAvailable,&#10;        dateValid:&#10;          some d in dateValidity satisfies&#10;            d.productId = item.productId&#10;            and d.dateValid = true&#10;      },&#10;  unavailable:&#10;    checkedItems[&#10;      stockAvailable != true or dateValid != true&#10;    ]&#10;}.unavailable&#10;&#10;&#10;" resultVariable="unavailableItems" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_03bl7rt</bpmn:incoming>
        <bpmn:outgoing>Flow_01bva2c</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Activity_01v6nn4" name="record order validation results">
        <bpmn:extensionElements>
          <zeebe:script expression="=count(customerOrder.orderItems) &#62; 0&#10;and count(unavailableItems) = 0&#10;" resultVariable="orderValidity" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_01bva2c</bpmn:incoming>
        <bpmn:outgoing>Flow_1kg08ea</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Activity_1e5o4a7" name="check expiry dates">
        <bpmn:extensionElements>
          <zeebe:script expression="=&#10;&#10;for item in itemAvailability return&#10;{&#10;  productId: item.productId,&#10;  requestedQuantity: item.requestedQuantity,&#10;  stockAvailable: item.stockAvailable,&#10;&#10;  dateValid:&#10;    some vendor in inventory satisfies&#10;      (some product in vendor.products satisfies&#10;        product.productId = item.productId&#10;        and product.bestBeforeDate != null&#10;        and date(product.bestBeforeDate) &#62;=&#10;            date(customerOrder.requestedFulfilmentDate))&#10;}&#10;" resultVariable="dateValidity" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0iflr8j</bpmn:incoming>
        <bpmn:outgoing>Flow_03bl7rt</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="Flow_0bxfe95" sourceRef="Event_1196rth" targetRef="Activity_0gdbqgt" />
      <bpmn:sequenceFlow id="Flow_1kg08ea" sourceRef="Activity_01v6nn4" targetRef="Event_06rm97f" />
      <bpmn:sequenceFlow id="Flow_0iflr8j" sourceRef="Activity_0gdbqgt" targetRef="Activity_1e5o4a7" />
      <bpmn:sequenceFlow id="Flow_03bl7rt" sourceRef="Activity_1e5o4a7" targetRef="Activity_1udgpxw" />
      <bpmn:sequenceFlow id="Flow_01bva2c" sourceRef="Activity_1udgpxw" targetRef="Activity_01v6nn4" />
