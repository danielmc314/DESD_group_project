    <bpmn:sendTask id="Activity_0ngfmzn" name="send order details to relevant vendors" zeebe:modelerTemplate="Template_190a0q1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
