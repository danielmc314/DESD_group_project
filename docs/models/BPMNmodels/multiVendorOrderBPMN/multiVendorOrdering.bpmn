    <bpmn:scriptTask id="Activity_0utyuso" name="initilise inventory data(testing task)">
      <bpmn:documentation>task is not intendended for final implimentation, only used for initilising inventory data during proccess testing</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:script expression="=&#10;[&#10;  {&#10;    vendorId: 10,&#10;    vendorName: &#34;Green Valley Farm&#34;,&#10;    products: [&#10;      {&#10;        productId: &#34;P001&#34;,&#10;        productName: &#34;Organic Carrots&#34;,&#10;        price: 2.5,&#10;        availableStock: 10,&#10;        bestBeforeDate: &#34;2026-11-20&#34;&#10;      },&#10;      {&#10;        productId: &#34;P002&#34;,&#10;        productName: &#34;Maris Piper Potatoes&#34;,&#10;        price: 1.8,&#10;        availableStock: 25,&#10;        bestBeforeDate: &#34;2026-12-01&#34;&#10;      }&#10;    ]&#10;  },&#10;  {&#10;    vendorId: 20,&#10;    vendorName: &#34;Local Dairy&#34;,&#10;    products: [&#10;      {&#10;        productId: &#34;P005&#34;,&#10;        productName: &#34;Mature Cheddar&#34;,&#10;        price: 4.5,&#10;        availableStock: 12,&#10;        bestBeforeDate: &#34;2026-12-10&#34;&#10;      }&#10;    ]&#10;  }&#10;]&#10;" resultVariable="inventory" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0904mej</bpmn:incoming>
      <bpmn:outgoing>Flow_05l740a</bpmn:outgoing>
    </bpmn:scriptTask>
